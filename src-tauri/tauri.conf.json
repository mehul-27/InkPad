{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkPad",
  "version": "1.1.0",
  "identifier": "com.inkpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InkPad",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["txt", "log", "conf", "ini", "env"],
        "name": "Text Document",
        "description": "Plain text document",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm", "css"],
        "name": "Web Document",
        "description": "Web source file",
        "role": "Editor"
      },
      {
        "ext": ["js", "mjs", "cjs", "jsx"],
        "name": "JavaScript Source",
        "description": "JavaScript source file",
        "role": "Editor"
      },
      {
        "ext": ["ts", "tsx"],
        "name": "TypeScript Source",
        "description": "TypeScript source file",
        "role": "Editor"
      },
      {
        "ext": ["py"],
        "name": "Python Source",
        "description": "Python source file",
        "role": "Editor"
      },
      {
        "ext": ["c", "h", "cpp", "hpp"],
        "name": "C/C++ Source",
        "description": "C or C++ source file",
        "role": "Editor"
      },
      {
        "ext": ["json", "yaml", "yml", "toml", "xml", "csv"],
        "name": "Data File",
        "description": "Structured data file",
        "role": "Editor"
      },
      {
        "ext": ["java"],
        "name": "Java Source",
        "description": "Java source file",
        "role": "Editor"
      },
      {
        "ext": ["rs"],
        "name": "Rust Source",
        "description": "Rust source file",
        "role": "Editor"
      },
      {
        "ext": ["go"],
        "name": "Go Source",
        "description": "Go source file",
        "role": "Editor"
      },
      {
        "ext": ["sql"],
        "name": "SQL Script",
        "description": "SQL script",
        "role": "Editor"
      }
    ]
  }
}
